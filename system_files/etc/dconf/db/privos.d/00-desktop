[org/gnome/desktop/interface]
color-scheme='prefer-dark'
icon-theme='Papirus-Dark'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 10'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/privos/privos-light.png'
picture-uri-dark='file:///usr/share/backgrounds/privos/privos-dark.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/privos/privos-dark.png'

[org/gnome/shell]
enabled-extensions=['dash-to-panel@jderose9.github.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox.desktop', 'org.gnome.Software.desktop']

[org/gnome/shell/extensions/dash-to-panel]
panel-position='BOTTOM'
panel-size=52
stockgs-keep-top-panel=false
trans-use-custom-bg=true
trans-bg-color='#15272f'
trans-use-custom-opacity=true
trans-panel-opacity=0.88
