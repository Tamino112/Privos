#!/usr/bin/bash
# Installiert die zum System-Treiber passende NVIDIA-Laufzeit für Flatpak-Apps
# (Steam, Blender, OBS … als Flatpak brauchen exakt dieselbe Treiberversion).
set -euo pipefail

version="$(cat /sys/module/nvidia/version)"
ref_version="${version//./-}"
refs=(
    "org.freedesktop.Platform.GL.nvidia-${ref_version}"
    "org.freedesktop.Platform.GL32.nvidia-${ref_version}"
)

installed() {
    for ref in "${refs[@]}"; do
        flatpak info --system "${ref}" >/dev/null 2>&1 || return 1
    done
}

case "${1:-sync}" in
    check)
        # Exit 0 = Synchronisation nötig
        if installed; then
            echo "NVIDIA-Flatpak-Laufzeit ${version} ist bereits installiert"
            exit 1
        fi
        echo "NVIDIA-Flatpak-Laufzeit ${version} fehlt"
        ;;
    sync)
        installed && exit 0
        flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        flatpak install --system --noninteractive -y flathub "${refs[@]}"
        ;;
    *)
        echo "Verwendung: $0 {check|sync}" >&2
        exit 2
        ;;
esac
