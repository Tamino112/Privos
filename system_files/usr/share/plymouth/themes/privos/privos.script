# Privos-Bootanimation für das Plymouth-Skript-Plugin.
#
# Dunkler Grund mit Petrol-Leuchten, helles Zeichen mit atmendem Lichthof
# und darunter eine schmale Ladelinie. Die Bilder erzeugt
# branding/make-boot-assets.py, das Zeichen rendert build_files/15-branding.sh.
# Plymouth ruft die Refresh-Funktion 50-mal pro Sekunde auf.

FPS = 50;
BAR_FRAMES = 75;
PROGRESS_STEPS = 50;

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
unit = screen_h / 1080;

Window.SetBackgroundTopColor(5 / 255, 9 / 255, 13 / 255);
Window.SetBackgroundBottomColor(5 / 255, 9 / 255, 13 / 255);

fun clamp(value, low, high) {
    if (value < low) return low;
    if (value > high) return high;
    return value;
}

fun smooth(from, to, value) {
    t = clamp((value - from) / (to - from), 0, 1);
    return t * t * (3 - 2 * t);
}

# --- Hintergrund: Höhe füllen, mittig; breitere Bildschirme mit Grundfarbe ---------
bg_image = Image("background.png");
bg_w = Math.Int(bg_image.GetWidth() * unit + 0.5);
bg_sprite = Sprite(bg_image.Scale(bg_w, screen_h));
bg_sprite.SetPosition(Math.Int((screen_w - bg_w) / 2), 0, -100);

center_x = screen_w / 2;
logo_y = screen_h * 0.44;

# --- Zeichen: passende Rendergröße wählen, damit kaum skaliert werden muss ---------
logo_h = Math.Int(96 * unit + 0.5);
if (logo_h <= 64) logo_file = "logo-64.png";
else if (logo_h <= 96) logo_file = "logo-96.png";
else if (logo_h <= 144) logo_file = "logo-144.png";
else logo_file = "logo-192.png";
logo_image = Image(logo_file).Scale(logo_h, logo_h);
logo_sprite = Sprite(logo_image);
logo_sprite.SetZ(10);
logo_sprite.SetOpacity(0);

halo_size = Math.Int(480 * unit + 0.5);
halo_sprite = Sprite(Image("halo.png").Scale(halo_size, halo_size));
halo_sprite.SetPosition(Math.Int(center_x - halo_size / 2), Math.Int(logo_y - halo_size / 2), 5);
halo_sprite.SetOpacity(0);

# --- Ladelinie ------------------------------------------------------------------
bar_w = Math.Int(180 * unit + 0.5);
bar_h = Math.Max(2, Math.Int(3 * unit + 0.5));
bar_x = Math.Int(center_x - bar_w / 2);
bar_y = Math.Int(logo_y + logo_h / 2 + 72 * unit);
for (i = 0; i < BAR_FRAMES; i++) {
    bar_images[i] = Image("bar-" + i + ".png").Scale(bar_w, bar_h);
}
bar_sprite = Sprite(bar_images[0]);
bar_sprite.SetPosition(bar_x, bar_y, 10);
bar_sprite.SetOpacity(0);

# --- Zustand --------------------------------------------------------------------
global.ticks = 0;
global.progress = -1;
global.dialog_open = 0;

mode = Plymouth.GetMode();
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade" || mode == "system-reset") {
    global.progress = 0;
    if (mode == "firmware-upgrade") title = "Firmware wird aktualisiert …";
    else if (mode == "system-reset") title = "System wird zurückgesetzt …";
    else title = "System wird aktualisiert …";
    title_sprite = Sprite(Image.Text(title, 0.96, 0.97, 0.96, 1, "Sans 15"));
    title_sprite.SetPosition(Math.Int(center_x - title_sprite.GetImage().GetWidth() / 2),
                             Math.Int(bar_y + 34 * unit), 10);
    hint_sprite = Sprite(Image.Text("Bitte den Computer nicht ausschalten", 0.96, 0.97, 0.96, 0.55, "Sans 11"));
    hint_sprite.SetPosition(Math.Int(center_x - hint_sprite.GetImage().GetWidth() / 2),
                            Math.Int(bar_y + 34 * unit + title_sprite.GetImage().GetHeight() + 6 * unit), 10);
}

fun refresh_callback() {
    global.ticks = global.ticks + 1;
    seconds = global.ticks / FPS;

    # Einblenden: das Zeichen gleitet leicht nach oben, danach erscheint die Linie.
    appear = smooth(0.0, 0.7, seconds);
    logo_sprite.SetPosition(Math.Int(center_x - logo_h / 2),
                            Math.Int(logo_y - logo_h / 2 + (1 - appear) * 14 * unit), 10);
    logo_sprite.SetOpacity(appear);

    # Der Lichthof atmet langsam (4 s pro Atemzug).
    breath = 0.5 - 0.5 * Math.Cos(seconds * 2 * Math.Pi / 4);
    halo_sprite.SetOpacity(smooth(0.2, 1.2, seconds) * (0.45 + 0.55 * breath));

    if (global.dialog_open) {
        bar_sprite.SetOpacity(0);
        return;
    }
    bar_sprite.SetOpacity(smooth(0.5, 1.1, seconds));
    if (global.progress >= 0) {
        bar_sprite.SetImage(progress_images[Math.Int(global.progress * PROGRESS_STEPS + 0.5)]);
    } else {
        bar_sprite.SetImage(bar_images[global.ticks % BAR_FRAMES]);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Fortschritt bei Updates ------------------------------------------------------
if (global.progress >= 0) {
    for (i = 0; i <= PROGRESS_STEPS; i++) {
        progress_images[i] = Image("progress-" + i + ".png").Scale(bar_w, bar_h);
    }
}

fun system_update_callback(percent) {
    if (global.progress >= 0)
        global.progress = clamp(percent / 100, 0, 1);
}
Plymouth.SetSystemUpdateFunction(system_update_callback);

# --- Passwort- und Fragedialog ------------------------------------------------------
entry_w = Math.Int(260 * unit + 0.5);
entry_h = Math.Int(38 * unit + 0.5);
entry_x = Math.Int(center_x - entry_w / 2);
entry_y = Math.Int(logo_y + logo_h / 2 + 92 * unit);
entry_image = Image("entry.png").Scale(entry_w, entry_h);
bullet_size = Math.Max(4, Math.Int(9 * unit + 0.5));
bullet_image = Image("bullet.png").Scale(bullet_size, bullet_size);
max_bullets = Math.Int((entry_w - 32 * unit) / (bullet_size * 1.8));

fun dialog_setup() {
    if (!global.dialog_open) {
        global.dialog_open = 1;
        global.entry_sprite = Sprite(entry_image);
        global.entry_sprite.SetPosition(entry_x, entry_y, 20);
        global.prompt_sprite = Sprite();
        global.text_sprite = Sprite();
    }
}

fun show_prompt(prompt) {
    if (!prompt) prompt = "Passwort";
    global.prompt_sprite.SetImage(Image.Text(prompt, 0.96, 0.97, 0.96, 0.8, "Sans 12"));
    global.prompt_sprite.SetPosition(
        Math.Int(center_x - global.prompt_sprite.GetImage().GetWidth() / 2),
        Math.Int(entry_y - global.prompt_sprite.GetImage().GetHeight() - 12 * unit), 20);
}

fun display_password_callback(prompt, bullet_count) {
    dialog_setup();
    show_prompt(prompt);
    shown = Math.Min(bullet_count, max_bullets);
    step = bullet_size * 1.8;
    start = center_x - (shown * step - (step - bullet_size)) / 2;
    for (i = 0; i < max_bullets; i++) {
        if (!global.bullets[i]) {
            global.bullets[i] = Sprite(bullet_image);
        }
        global.bullets[i].SetPosition(Math.Int(start + i * step),
                                      Math.Int(entry_y + (entry_h - bullet_size) / 2), 21);
        if (i < shown) global.bullets[i].SetOpacity(1);
        else global.bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry) {
    dialog_setup();
    show_prompt(prompt);
    global.text_sprite.SetImage(Image.Text(entry, 0.96, 0.97, 0.96, 1, "Sans 12"));
    global.text_sprite.SetPosition(
        Math.Int(center_x - global.text_sprite.GetImage().GetWidth() / 2),
        Math.Int(entry_y + (entry_h - global.text_sprite.GetImage().GetHeight()) / 2), 21);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    if (global.dialog_open) {
        global.dialog_open = 0;
        global.entry_sprite = NULL;
        global.prompt_sprite = NULL;
        global.text_sprite = NULL;
        global.bullets = NULL;
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Meldungen am unteren Rand ----------------------------------------------------
message_sprite = Sprite();
message_sprite.SetZ(10);

fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.96, 0.97, 0.96, 0.6, "Sans 11"));
    message_sprite.SetPosition(Math.Int(center_x - message_sprite.GetImage().GetWidth() / 2),
                               Math.Int(screen_h - 64 * unit), 10);
}
Plymouth.SetMessageFunction(message_callback);
